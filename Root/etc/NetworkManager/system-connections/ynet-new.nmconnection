[connection]
id=ynet
uuid=ef31e8f0-bbd9-4285-96fc-945501c832e2
type=wifi
interface-name=wlp0s20f3

[wifi]
band=a
mode=infrastructure
ssid=Ynet

[wifi-security]
key-mgmt=wpa-eap

[802-1x]
ca-cert=/etc/ssl/certs/ca-certificates.crt
domain-suffix-match=ynet.sk
eap=peap;
identity=xbabak@ynet.sk
password=<redacted>
phase2-auth=mschapv2
password-flags=0

[ipv4]
method=auto

[ipv6]
addr-gen-mode=stable-privacy
method=auto

[proxy]
