# /etc/udev/rules.d/70-nvme-names.rules
SUBSYSTEM!="block", GOTO="nvme_names_end"
ENV{ID_SERIAL}=="WD_BLACK_SN7100_1TB_260409801173_1", ENV{DEVTYPE}=="disk", SYMLINK+="sn7100"
ENV{ID_SERIAL}=="WD_BLACK_SN7100_1TB_260409801173_1", ENV{DEVTYPE}=="partition", SYMLINK+="sn7100_p$env{PARTN}"
ENV{ID_SERIAL}=="Samsung_SSD_980_PRO_500GB_S5NYNL0T600317W_1", ENV{DEVTYPE}=="disk", SYMLINK+="980pro"
ENV{ID_SERIAL}=="Samsung_SSD_980_PRO_500GB_S5NYNL0T600317W_1", ENV{DEVTYPE}=="partition", SYMLINK+="980pro_p$env{PARTN}"
LABEL="nvme_names_end"
