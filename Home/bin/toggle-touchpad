#!/bin/bash

# "Device Enabled" 0 floats the device, and Qt never registers a device
# that was floating when the app started, so its scrolling is ignored.
prop="libinput Send Events Mode Enabled"

xinput list --name-only | grep -i touchpad | while read -r dev; do
  if xinput list-props "$dev" | grep -q "$prop ([0-9]*):[[:space:]]*1,"; then
    xinput set-prop "$dev" "$prop" 0 0
  else
    xinput set-prop "$dev" "$prop" 1 0
  fi
done
