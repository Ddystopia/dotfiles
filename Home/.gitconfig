[user]
  email = alexanderbabak@proton.me
	name = Oleksandr Babak
	signingkey = B21CA2CAC0240BB9
[core]
	editor = nvim
	pager = delta
[init]
	defaultBranch = main
[credential]
	helper = store
[alias]
	root = rev-parse --show-toplevel
[commit]
	gpgsign = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	dark = true
[merge]
	conflictStyle = zdiff3
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
